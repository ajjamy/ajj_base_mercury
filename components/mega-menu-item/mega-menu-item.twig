<li class="mega-menu-item" data-mega-menu-item>
  <div class="mega-menu-item__heading">
    {% if href %}
      <a class="mega-menu-item__link" href="{{ href }}">{{ label }}</a>
    {% else %}
      <span class="mega-menu-item__link">{{ label }}</span>
    {% endif %}

    {% if has_dropdown %}
      <button
        class="mega-menu-item__toggle"
        type="button"
        aria-label="{{ 'Toggle submenu for @label'|t({
          '@label': label
        }) }}"
        aria-controls="{{ id }}-dropdown"
        aria-expanded="false"
        data-mega-menu-item-toggle
      >
        <span class="mega-menu-item__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 24 24"><path fill="none" stroke="#003866" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 8.5 7 7 7-7"/></svg>
        </span>
      </button>
    {% endif %}
  </div>

  {% if has_dropdown %}
    <div id="{{ id }}-dropdown" class="mega-menu-item__dropdown" data-mega-menu-dropdown>
      {% block dropdown %}

      {% endblock %}
    </div>
  {% endif %}
</li>

{% set dropdown_menu =
  html_cva(
    base: ['navbar--dropdown-menu'],
    variants: {
      menuAlign: {
        left: 'md:justify-start',
        center: 'md:justify-center',
        right: 'md:justify-end'
      }
    }
  )
%}

{% set dropdown_menu_classes =
  dropdown_menu.apply({
    menuAlign: menu_align|default('center')
  })
%}

<div class="navbar">
  <div class="navbar--logo">
    {% block logo %}
      {{ include('@ajj_base_mercury/templates/block/block--system-branding-block.html.twig') }}
    {% endblock %}
  </div>

  <div class="navbar--menu">
    <div class="navbar--modal-top" >
      <div class="navbar--modal-logo">
        {{ block('logo') }}
      </div>

      <button class="navbar--hide-menu" aria-label="{{ 'Hide menu'|t }}">
        {{
          include(
            '@ajj_base_mercury/components/icon/icon.twig',
            {
              icon: 'x',
              icon_size: 'medium'
            }
          )
        }}
      </button>
    </div>

    <div class="navbar--dropdown-menu-wrapper">
      <div class="{{ dropdown_menu_classes }}">
        {% block navigation %}

        {% endblock %}
      </div>
    </div>

    <div class="navbar--links">
      {% block links %}
        {{
          include(
            'ajj_base_mercury:button',
            {
              variant: 'primary',
              label: 'Button'|t,
              icon: 'arrow-right',
              href: 'https://example.com',
              size: 'medium'
            }
          )
        }}

        {{
          include(
            'ajj_base_mercury:button',
            {
              variant: 'secondary',
              label: 'Another'|t,
              icon: 'arrow-right',
              href: 'https://example.com',
              size: 'medium'
            }
          )
        }}
      {% endblock %}
    </div>
  </div>

  <div class="navbar--hamburger-container">
    <button class="navbar--hamburger flex items-center justify-center" aria-label="{{ 'Show menu'|t }}">
      {{
        include(
          '@ajj_base_mercury/components/icon/icon.twig',
          {
            icon: 'list',
            icon_size: 'medium'
          }
        )
      }}
    </button>
  </div>
</div>

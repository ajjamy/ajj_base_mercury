{#
  Number card: same layout and options as the Icon card, but features a
  number or short text (e.g. "1M+") in place of the icon.
#}
{% set has_url = url is not empty ? 'yes' : 'no' %}

{% set tile =
  html_cva(
    base: ['card-number @container'],
    variants: {
      hasUrl: {
        yes: 'group cursor-pointer hover:scale-101',
        no: ''
      },
      backgroundColor: {
        primary: 'bg-primary text-primary-foreground',
        background: 'border border-border bg-background text-foreground',
        secondary: 'bg-secondary text-secondary-foreground',
        accent: 'bg-accent text-accent-foreground',
        muted: 'bg-muted text-muted-foreground',
        noColor: 'border border-border bg-none text-foreground'
      },
      tileSize: {
        square: 'aspect-square',
        '4:3': 'aspect-4/3',
        '16:9': 'aspect-16/9',
        noSize: 'aspect-none'
      },
      borderRadius: {
        small: 'rounded-sm',
        medium: 'rounded-xl md:rounded-2xl',
        large: 'rounded-[24px] md:rounded-[32px]',
        noRadius: 'rounded-none'
      }
    },
    compoundVariants: [
      {
        hasUrl: 'yes',
        backgroundColor: 'primary',
        class: 'hover:bg-primary/90'
      },
      {
        hasUrl: 'yes',
        backgroundColor: 'background',
        class: 'hover:bg-background/90 hover:text-foreground'
      },
      {
        hasUrl: 'yes',
        backgroundColor: 'secondary',
        class: 'hover:bg-secondary/70'
      },
      {
        hasUrl: 'yes',
        backgroundColor: 'accent',
        class: 'hover:bg-accent/70'
      },
      {
        hasUrl: 'yes',
        backgroundColor: 'muted',
        class: 'hover:bg-muted/70'
      },
      {
        hasUrl: 'yes',
        backgroundColor: 'noColor',
        class: 'hover:text-foreground/90'
      }
    ]
  )
%}

{% set tile_classes =
  tile.apply({
    hasUrl: has_url,
    backgroundColor: background_color|default('noColor'),
    tileSize: tile_size|default('noSize'),
    borderRadius: border_radius|default('noRadius')
  })
%}

{% set number_container =
  html_cva(
    base: ['flex', 'w-full'],
    variants: {
      numberAlign: {
        left: 'justify-start',
        center: 'justify-center',
        right: 'justify-end'
      }
    }
  )
%}

{% set number_container_classes =
  number_container.apply({
    numberAlign: number_align|default('center')
  })
%}

{% set number_variants =
  html_cva(
    base: ['font-semibold', 'leading-none', 'tracking-tight'],
    variants: {
      numberStyle: {
        primary: 'text-primary',
        primary_background: 'rounded-md bg-accent px-3 py-2 text-primary',
        secondary_background: 'rounded-md bg-muted px-3 py-2 text-muted-foreground',
        inherit: ''
      },
      numberSize: {
        small: 'text-2xl',
        medium: 'text-4xl',
        large: 'text-5xl @sm:text-6xl',
        'extra-large': 'text-6xl @sm:text-7xl'
      }
    }
  )
%}

{% set number_classes =
  number_variants.apply({
    numberStyle: number_style|default('inherit'),
    numberSize: number_size|default('medium')
  })
%}

{% set text_container =
  html_cva(
    base: ['w-full', 'pt-2'],
    variants: {
      textAlign: {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end'
      }
    }
  )
%}

{% set text_container_classes =
  text_container.apply({
    textAlign: text_align|default('center')
  })
%}

{% set heading_classes = ['text-2xl font-semibold @sm:text-3xl @2xl:text-4xl'] %}
{% set description_classes = ['mt-3 font-body text-md @sm:text-lg @2xl:text-xl'] %}

<div class="{{ tile_classes }}">
  <div class="flex h-full flex-col justify-center">
    {% if number is not empty %}
      <div class="{{ number_container_classes }}">
        <span class="{{ number_classes }}">{{ number }}</span>
      </div>
    {% endif %}

    <div class="{{ text_container_classes }}">
      {% if text is not empty or description is not empty %}
        {% if url is not empty %}
          <a href="{{ url }}" class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="{{ heading_classes|join(' ') }}">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="{{ description_classes|join(' ') }}">{{ description }}</span>
            {% endif %}
          </a>
        {% else %}
          <span class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="{{ heading_classes|join(' ') }}">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="{{ description_classes|join(' ') }}">{{ description }}</span>
            {% endif %}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

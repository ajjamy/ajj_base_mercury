{# Columns set the column count, up to four (featured content is separate).
   Mobile-only columns are hidden on desktop, so they don't count toward the four
   or the column count. A column only gets a heading if it has one (menu items
   set to <nolink>); otherwise it is just a list of links. #}
{% set visible_columns = [] %}
{% set desktop_column_count = 0 %}
{% for column in columns|default([]) %}
  {% if column.mobile_only %}
    {% set visible_columns = visible_columns|merge([column]) %}
  {% elseif desktop_column_count < 4 %}
    {% set visible_columns = visible_columns|merge([column]) %}
    {% set desktop_column_count = desktop_column_count + 1 %}
  {% endif %}
{% endfor %}

{% set content_variants =
  html_cva(
    base: 'mega-menu-content',
    variants: {
      featuredPosition: {
        left: 'mega-menu-content--featured-left',
        right: ''
      }
    }
  )
%}

<div
  class="{{
  content_variants.apply({
    featuredPosition: featured_position|default('right')
  })
  }} mega-menu-content--cols-{{ max(desktop_column_count, 1) }}"
  id="{{ id }}"
>
  <div class="mega-menu-content__columns">
    {% for column in visible_columns %}
      <section class="mega-menu-content__column{{ column.mobile_only ? ' nav:hidden' }}">
        {% if column.heading is not empty %}
          <h2 class="mega-menu-content__heading text-base">{{ column.heading }}</h2>
        {% endif %}
        {% if column.links %}
          <ul class="mega-menu-content__links" role="list">
            {% for link_item in column.links %}
              <li class="{{ link_item.mobile_only ? 'nav:hidden' }}">
                <a class="mega-menu-content__link" href="{{ link_item.href }}">{{ link_item.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endfor %}
  </div>

  {# Slot default prints the variable so it also works via include(). #}
  {% set featured_content %}
    {% block featured %}
      {{ featured }}
    {% endblock %}
  {% endset %}
  {% if featured_content|trim %}
    <aside class="mega-menu-content__featured">
      {{ featured_content }}
    </aside>
  {% endif %}
</div>

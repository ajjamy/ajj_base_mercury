{% set content_variants =
  html_cva(
    base: 'mega-menu-content',
    variants: {
      featuredPosition: {
        left: 'mega-menu-content--featured-left',
        right: ''
      }
    }
  )
%}

<div
  class="{{
  content_variants.apply({
    featuredPosition: featured_position|default('right')
  })
  }}"
  id="{{ id }}"
>
  <div class="mega-menu-content__columns">
    {% for column in columns %}
      <section class="mega-menu-content__column">
        {% if column.heading %}
          <h2 class="mega-menu-content__heading">{{ column.heading }}</h2>
        {% endif %}
        {% if column.links %}
          <ul class="mega-menu-content__links" role="list">
            {% for link_item in column.links %}
              <li><a class="mega-menu-content__link" href="{{ link_item.href }}">{{ link_item.label }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endfor %}
  </div>

  {# Slot default prints the variable so it also works via include(). #}
  {% set featured_content %}
    {% block featured %}
      {{ featured }}
    {% endblock %}
  {% endset %}
  {% if featured_content|trim %}
    <aside class="mega-menu-content__featured">
      {{ featured_content }}
    </aside>
  {% endif %}
</div>

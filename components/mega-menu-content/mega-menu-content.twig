{# Headed columns set the column count, up to four (featured content is separate).
   Without any headings (e.g. simple dropdowns) the columns render as given. #}
{% set headed_columns = columns|default([])|filter(column => column.heading is not empty) %}
{% set visible_columns = headed_columns is not empty ? headed_columns|slice(0, 4) : columns|default([]) %}

{% set content_variants =
  html_cva(
    base: 'mega-menu-content',
    variants: {
      featuredPosition: {
        left: 'mega-menu-content--featured-left',
        right: ''
      }
    }
  )
%}

<div
  class="{{
  content_variants.apply({
    featuredPosition: featured_position|default('right')
  })
  }} mega-menu-content--cols-{{ max(visible_columns|length, 1) }}"
  id="{{ id }}"
>
  <div class="mega-menu-content__columns">
    {% for column in visible_columns %}
      <section class="mega-menu-content__column{{ column.mobile_only ? ' nav:hidden' }}">
        <h2 class="h6 mega-menu-content__heading">{{ column.heading }}</h2>
        {% if column.links %}
          <ul class="mega-menu-content__links" role="list">
            {% for link_item in column.links %}
              <li class="{{ link_item.mobile_only ? 'nav:hidden' }}">
                <a class="mega-menu-content__link" href="{{ link_item.href }}">{{ link_item.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
    {% endfor %}
  </div>

  {# Slot default prints the variable so it also works via include(). #}
  {% set featured_content %}
    {% block featured %}
      {{ featured }}
    {% endblock %}
  {% endset %}
  {% if featured_content|trim %}
    <aside class="mega-menu-content__featured">
      {{ featured_content }}
    </aside>
  {% endif %}
</div>

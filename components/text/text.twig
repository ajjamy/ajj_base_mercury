{% set text_text_color = text_color|default('default') %}
{% set text_text_size = text_size|default('normal') %}

{# Styles for the base and variant classes live in text.tailwind.css. #}
{% set text_component =
  html_cva(
    base: ['rich-text'],
    variants: {
      textColor: {
        default: 'rich-text--color-default',
        inverted: 'rich-text--color-inverted',
        primary: 'rich-text--color-primary'
      },
      textSize: {
        'text-xs': 'rich-text--size-xs',
        'text-sm': 'rich-text--size-sm',
        normal: 'rich-text--size-normal',
        'text-lg': 'rich-text--size-lg',
        'text-xl': 'rich-text--size-xl',
        'text-2xl': 'rich-text--size-2xl',
        'text-3xl': 'rich-text--size-3xl'
      }
    }
  )
%}

{% set text_classes =
  text_component.apply({
    textColor: text_text_color,
    textSize: text_text_size
  })
%}

<div class="{{ text_classes }}">
  {{ text }}
</div>

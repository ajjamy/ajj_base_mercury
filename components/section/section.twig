{# Boolean for conditionals #}
{% set has_background_image = background_media is not empty and background_media.src is not empty %}
{# String for CVA variants #}
{% set has_background_image_variant = has_background_image ? 'yes' : 'no' %}

{# Styles for all classes below live in section.tailwind.css. #}
{% set section =
  html_cva(
    base: ['section'],
    variants: {
      backgroundColor: {
        primary: 'section--primary',
        secondary: 'section--secondary',
        accent: 'section--accent',
        muted: 'section--muted',
        'gradient-light': 'section--gradient-light',
        noColor: 'section--no-color'
      }
    }
  )
%}

{% set section_classes =
  section.apply({
    backgroundColor: background_color|default('noColor')
  })
%}

{% set content =
  html_cva(
    base: ['section__content'],
    variants: {
      width: {
        '100%': 'section__content--width-100',
        '90%': 'section__content--width-90',
        '80%': 'section__content--width-80',
        '75%': 'section__content--width-75',
        '50%': 'section__content--width-50'
      }
    }
  )
%}

{% set section_content =
  content.apply({
    width: width|default('80%')
  })
%}

{% set background =
  html_cva(
    base: ['section__background'],
    variants: {
      backgroundColor: {
        primary: 'section__background--primary',
        secondary: 'section__background--secondary',
        accent: 'section__background--accent',
        muted: 'section__background--muted',
        noColor: 'section__background--no-color',
        'gradient-light': 'section__background--gradient-light'
      },
      backgroundImage: {
        yes: 'section__background--has-image',
        no: ''
      }
    }
  )
%}

{% set background_classes =
  background.apply({
    backgroundColor: background_color|default('noColor'),
    backgroundImage: has_background_image_variant
  })
%}

{% set grid =
  html_cva(
    base: ['section__grid'],
    variants: {
      columns: {
        '100': 'section__grid--cols-100',
        '50-50': 'section__grid--cols-50-50',
        '33-33-33': 'section__grid--cols-33-33-33',
        '75-25': 'section__grid--cols-75-25',
        '25-75': 'section__grid--cols-25-75',
        '67-33': 'section__grid--cols-67-33',
        '33-67': 'section__grid--cols-33-67',
        '50-25-25': 'section__grid--cols-50-25-25',
        '25-25-50': 'section__grid--cols-25-25-50',
        '25-25-25-25': 'section__grid--cols-25-25-25-25'
      },
      mobileColumns: {
        '1': '',
        '2': 'section__grid--mobile-2',
        '3': 'section__grid--mobile-3'
      },
      viewsColumns: {
        '100': '',
        '50-50': 'section__grid--views-50-50',
        '33-33-33': 'section__grid--views-33-33-33',
        '25-25-25-25': 'section__grid--views-25-25-25-25'
      }
    }
  )
%}

{% set grid_classes =
  grid.apply({
    columns: columns|default('100'),
    mobileColumns: mobile_columns|default('1'),
    viewsColumns: views_columns|default('100')
  })
%}

{% set section_attributes = create_attribute() %}
{# clean_class (not clean_id) so the ID stays exactly as typed, without a uniqueness suffix. #}
{% if section_id is not empty %}
  {% set section_attributes = section_attributes.setAttribute('id', section_id|clean_class) %}
{% endif %}

{# cq-full stays inline: it is a theme utility that other components select on. #}
<section {{ section_attributes }} class="{{ section_classes }} cq-full">
  {# if there is background media #}
  {% if background_media is not empty and background_media.src is not empty %}
    {% block background_media_block %}
      <div class="section__media">
        {% include 'canvas:image' ignore missing with {
          src: background_media.src,
          alt: background_media.alt,
          class: 'section__media-image',
          width: background_media.width,
          height: background_media.height,
          attributes: create_attribute({
            style: 'object-position: ' ~ (background_position|default('50% 50%')) ~ ';'
          })
        } only %}
      </div>
    {% endblock %}
  {% endif %}

  {# if there is background color (can work with or without background media) #}
  {% if background_color is not empty %}
    <div class="{{ background_classes }}"></div>
  {% endif %}

  <div class="section__container">
    <div class="{{ section_content }}">
      {% if section_header %}
        {% set header_content %}
          {% block header_slot %}

          {% endblock %}
        {% endset %}
        {% if header_content|trim is not empty %}
          <header class="section__header">
            {{ header_content }}
          </header>
        {% endif %}
      {% endif %}

      <div class="{{ grid_classes }}">
        {% block main_slot %}

        {% endblock %}
      </div>

      {% if section_footer %}
        {% set footer_content %}
          {% block footer_slot %}

          {% endblock %}
        {% endset %}
        {% if footer_content|trim is not empty %}
          <footer class="section__footer">
            {{ footer_content }}
          </footer>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{#
/**
 * @file
 * Related case studies field.
 *
 * The wrapper uses display: contents so each referenced item becomes a direct
 * item of the surrounding grid (for example a Section with a 33-33-33 grid),
 * instead of all items sharing one grid cell.
 */
#}
{% set field_classes = ['contents', 'field--related-case-studies'] %}

<div {{ attributes.addClass(field_classes) }}>
  {% if not label_hidden %}
    <div {{ title_attributes.addClass('col-span-full') }}>
      {{ label }}
    </div>
  {% endif %}
  {% for item in items %}
    <div {{ item.attributes.addClass('min-w-0') }}>
      {{ item.content }}
    </div>
  {% endfor %}
</div>

{#
/**
 * @file
 * Default template for a Canvas page entity.
 *
 * Renders only the page's components, with no wrapper, so pages look the
 * same as before this template existed. Override per view mode with
 * canvas-page--VIEW-MODE.html.twig, e.g. canvas-page--teaser.html.twig.
 *
 * Available variables:
 * - content: The page's rendered components.
 * - canvas_page: The canvas_page entity.
 * - view_mode: The view mode, e.g. "full" or "teaser".
 */
#}
{{ content }}

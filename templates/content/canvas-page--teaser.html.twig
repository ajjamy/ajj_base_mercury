{#
/**
 * @file
 * Teaser display for a Canvas page.
 *
 * Renders the Card component with the same settings as the node teaser Canvas templates (e.g. canvas.content_template.node.basic_page.teaser), so Canvas pages and nodes look the same in the mega menu.
 *
 * Available variables:
 * - teaser_heading: Text of the page's H1 component, or the page title when it has none.
 * - teaser_media: The page's image as {src, alt, width, height}, or null.
 * - teaser_url: The page's URL.
 * - canvas_page: The canvas_page entity.
 *
 * @see \Drupal\ajj_base_mercury\Hook\ThemeHooks::preprocessCanvasPage()
 */
#}
{{
  include(
    'ajj_base_mercury:card',
    {
      background: 'default',
      style: 'full',
      orientation: 'vertical',
      heading_text: teaser_heading,
      level: 3,
      url: teaser_url,
      media: teaser_media,
      is_text_centered: false
    },
    with_context: false
  )
}}

{#
/**
 * @file
 * Theme override for the News view, "All News Block" (all_news_filter) display.
 *
 * Places the Better Exposed Filters form in a left sidebar beside the results.
 * On small screens the filters stack above the results.
 *
 * @see views-view.html.twig for available variables.
 */
#}
{% set classes = [
  'view',
  'view-' ~ (id|clean_class),
  'view-id-' ~ id,
  'view-display-id-' ~ display_id,
  dom_id ? 'js-view-dom-id-' ~ dom_id
] %}

{% set has_filters = exposed is not empty ? 'yes' : 'no' %}

{% set layout =
  html_cva(
    base: ['grid', 'grid-cols-1', 'gap-8'],
    variants: {
      hasFilters: {
        yes: 'lg:grid-cols-[16rem_1fr]',
        no: ''
      }
    }
  )
%}

<div {{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}

  <div
    class="{{
    layout.apply({
      hasFilters: has_filters
    })
    }}"
  >
    {% if exposed %}
      <aside class="view-filters lg:sticky lg:top-8 lg:self-start" aria-label="{{ 'Filter news'|t }}">
        {{ exposed }}
      </aside>
    {% endif %}

    <div class="view-main min-w-0">
      {% if attachment_before %}
        <div class="attachment attachment-before">
          {{ attachment_before }}
        </div>
      {% endif %}

      {% if rows %}
        <div class="view-content">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}

      {% if pager %}
        {{ pager }}
      {% endif %}

      {% if attachment_after %}
        <div class="attachment attachment-after">
          {{ attachment_after }}
        </div>
      {% endif %}

      {% if more %}
        {{ more }}
      {% endif %}
    </div>
  </div>

  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
</div>
